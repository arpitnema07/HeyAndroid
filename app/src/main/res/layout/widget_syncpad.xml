<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_brief_bg"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_syncpad_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:letterSpacing="0.08"
        android:text="@string/widget_syncpad_title"
        android:textAllCaps="true"
        android:textColor="#8FA8FF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/widget_syncpad_refresh"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_centerVertical="true"
        android:background="@drawable/widget_refresh_bg"
        android:contentDescription="@string/widget_syncpad_refresh"
        android:padding="7dp"
        android:src="@drawable/ic_refresh" />

    <ImageButton
        android:id="@+id/widget_syncpad_paste"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_alignParentTop="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="6dp"
        android:layout_toStartOf="@id/widget_syncpad_refresh"
        android:background="@drawable/widget_refresh_bg"
        android:contentDescription="@string/widget_syncpad_paste"
        android:padding="7dp"
        android:src="@drawable/ic_paste" />

    <LinearLayout
        android:id="@+id/widget_syncpad_clips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_syncpad_title"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/widget_syncpad_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_syncpad_title"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/widget_syncpad_empty"
        android:textColor="#B0AEBD"
        android:textSize="12sp" />
</RelativeLayout>
